{
    "name": "duxbo/laravel-auth",
    "description": "Full user management, fine-grained per-route permissions, and complete auth flows for Laravel — works with Blade, API and Inertia.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "duxbo",
            "email": "dungduc10a8@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Dungnecauoi/laravel-core-kit.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Dungnecauoi/laravel-ai-core.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "laravel/sanctum": "^4.0",
        "duxbo/laravel-core": "^0.3.0"
    },
    "suggest": {
        "pragmarx/google2fa": "Required to enable two-factor authentication (features.two_factor).",
        "bacon/bacon-qr-code": "Required to render the two-factor authentication QR code.",
        "laravel/socialite": "Required to enable social login (features.social_login).",
        "inertiajs/inertia-laravel": "Required when using the 'inertia' or 'hybrid' frontend flavor.",
        "duxbo/laravel-blade-kit": "Peer dependency for the 'blade' stack — this package's Blade views use its <x-layouts.*> and <x-admin.*> components, resolved against whatever the host app has installed (`php artisan blade-kit:install`). Not needed for 'api'/'headless'."
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Duxbo\\LaravelAuth\\": "src/",
            "Duxbo\\LaravelAuth\\Database\\Factories\\": "database/factories/",
            "Duxbo\\LaravelAuth\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Duxbo\\LaravelAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Duxbo\\LaravelAuth\\LaravelAuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
